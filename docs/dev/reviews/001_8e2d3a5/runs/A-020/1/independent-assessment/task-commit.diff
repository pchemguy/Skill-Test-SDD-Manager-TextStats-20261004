+"""Immutable statistics and pure decoded-text counting.
+
+Only CRLF, CR and LF delimit lines; Unicode whitespace delimits words.
+Acquisition, decoding and output belong to other components.
+"""
+
+from dataclasses import dataclass
+import re
+
+
+@dataclass(frozen=True)
+class TextStats:
+    """Counts of logical lines and words, stored as nonnegative integers.
+
+    Attributes:
+        lines: Number of CR/LF-delimited logical lines.
+        words: Number of Unicode-whitespace-separated words.
+
+    Raises:
+        TypeError: Either field is not an integer count (including bool).
+        ValueError: Either field is negative.
+    """
+
+    lines: int
+    words: int
+
+    def __post_init__(self) -> None:
+        for name in ("lines", "words"):
+            value = getattr(self, name)
+            if not isinstance(value, int) or isinstance(value, bool):
+                raise TypeError(f"{name} must be an integer")
+            if value < 0:
+                raise ValueError(f"{name} must be nonnegative")
+
+
+def count_text(text: str, *, strip_bom: bool = True) -> TextStats:
+    """Count complete decoded text without acquisition or output.
+
+    Args:
+        text: Caller-owned Unicode text.
+        strip_bom: Remove exactly one leading U+FEFF when true. Interior
+            BOMs, a second leading BOM and all BOMs when false are retained.
+
+    Returns:
+        Immutable counts. CRLF counts as one terminator, lone CR/LF as one
+        each, and a nonempty unterminated final segment as one line. A
+        trailing terminator adds no phantom line. Other Unicode separators
+        affect words through str.split(), but do not terminate lines.
+    """
+    if strip_bom and text.startswith("\ufeff"):
+        text = text[1:]
+    lines = sum(1 for _ in re.finditer(r"\r\n|\r|\n", text))
+    if text and not text.endswith(("\r", "\n")):
+        lines += 1
+    return TextStats(lines=lines, words=len(text.split()))
